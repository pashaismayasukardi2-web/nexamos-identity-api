# NexaMOS Identity API — Environment Variables
# Salin file ini ke .env dan isi nilainya.
# JANGAN commit .env ke git!

# ── Server ───────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── MySQL (Hostinger — u294320793_nexamain) ──────
IAM_DB_HOST=srv1412.hstgr.io
IAM_DB_PORT=3306
IAM_DB_USER=u294320793_adminmain
IAM_DB_PASSWORD=your_db_password_here
IAM_DB_NAME=u294320793_nexamain

# ── Keycloak OIDC ────────────────────────────────
# URL publik Keycloak di VPS
KEYCLOAK_BASE_URL=https://nexamos.cloud/identity
KEYCLOAK_REALM=nexamos
# JWKS endpoint untuk verifikasi token (auto dari Keycloak)
KEYCLOAK_JWKS_URI=https://nexamos.cloud/identity/realms/nexamos/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://nexamos.cloud/identity/realms/nexamos

# ── CORS Allowlist ───────────────────────────────
# Pisahkan dengan koma
CORS_ORIGINS=https://crm.nexamos.cloud,https://studio.nexamos.cloud,https://workspace.nexamos.cloud,https://superadmin.nexamos.cloud,https://nexamos.cloud

# ── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

